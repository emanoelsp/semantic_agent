# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
EDGE_INTEGRITY_SECRET=replace-with-a-second-long-random-secret
ALLOW_DEMO_FALLBACK=true

# Gemini (required for production semantic mapping)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Pinecone RAG (optional locally; required to enable cloud retrieval)
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=eclass-14
PINECONE_EMBEDDING_DIMENSION=768
# Opcional; deve corresponder aos campos realmente presentes no índice.
PINECONE_METADATA_FILTER_JSON=

# Cohere reranking (optional; Pinecone remains the first-stage retrieval)
COHERE_API_KEY=
COHERE_RERANK_URL=https://api.cohere.com/v2/rerank
COHERE_RERANK_MODEL=rerank-v5.0-fast
COHERE_RERANK_TOP_N=5
COHERE_RERANK_MAX_DOCS=20
COHERE_RERANK_MAX_TOKENS_PER_DOC=2048
COHERE_RERANK_MIN_SCORE=0
COHERE_RERANK_TIMEOUT_MS=5000
# Gate de evidência: o IRDI proposto precisa aparecer no contexto recuperado.
EVIDENCE_MISSING_PENALTY=0.25
EVIDENCE_LOW_RERANK_PENALTY=0.15
EVIDENCE_MIN_RERANK_SCORE=0

# Firebase Admin (required for production persistence/authentication)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Firebase Web SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Payments (required before selling credits)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Edge / Node-RED
SEMANTIC_EDGE_TOKEN=

# Billing policy (keep provider costs and customer prices separate)
BILLING_CURRENCY=BRL
BILLING_PRICE_MODE=credits
BILLING_CREDIT_VALUE_BRL=0.50
# 11x = preço equivalente a custo + 1.000% de lucro sobre o custo.
# Não use 95x como padrão: isso representa aproximadamente 9.400% de lucro.
BILLING_MARGIN_MULTIPLIER=11.0
BILLING_ESTIMATE_BUFFER_PCT=20
BILLING_MIN_CHARGE_CREDITS=1
BILLING_MAX_CHARGE_CREDITS=10000

# Operation pricing in credits before final usage settlement
BILLING_MAPPING_BASE_CREDITS=1
BILLING_MAPPING_DESCRIPTION_BLOCK_CHARS=2000
BILLING_MAPPING_DESCRIPTION_BLOCK_CREDITS=1
BILLING_DATASHEET_BASE_CREDITS=5
BILLING_DATASHEET_PER_DATAPOINT_CREDITS=1
BILLING_DATASHEET_PER_MB_CREDITS=1
BILLING_TELEMETRY_POINTS_PER_CREDIT=1000
BILLING_EDGE_MESSAGES_PER_CREDIT=1000
BILLING_AASX_BASE_CREDITS=10
BILLING_AASX_PER_DATAPOINT_CREDITS=1

# Provider cost ledger. Fill with the prices from the exact Gemini/Pinecone
# plans/models used in production; values are in USD per 1M units.
BILLING_USD_TO_BRL=
GEMINI_INPUT_USD_PER_1M_TOKENS=
GEMINI_OUTPUT_USD_PER_1M_TOKENS=
GEMINI_EMBEDDING_USD_PER_1M_TOKENS=
PINECONE_USD_PER_1M_READ_UNITS=
COHERE_USD_PER_1K_SEARCH_UNITS=
BILLING_INFRA_USD_PER_REQUEST=0
